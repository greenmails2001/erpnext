COMPOSE_PROJECT_NAME=erpnext-staging
SITE_NAME=erpnext-staging.example.internal
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PUBLISH_PORT=18080

# Generate these values outside Git, then save them in deploy/staging/.env.
DB_PASSWORD=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-long-random-value

# Tune after measuring the staging workload.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
BACKUP_RETENTION_DAYS=14
